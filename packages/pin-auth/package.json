{
  "name": "@brian/pin-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && echo 'pin-auth: no bundle needed (source consumed via workspace)'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@brian/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}
