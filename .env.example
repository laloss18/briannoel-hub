# ---------------------------------------------------------------------------
# Single Supabase project (MVP). No staging/test project — the sync engine is
# transport-tested in-memory + MSW, so no CI job mutates a real DB.
# Copy to `.env.local` (never committed). The service key stays LOCAL ONLY.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Local-only (development). NEVER set in GitHub secrets / CI.
SUPABASE_SERVICE_KEY=<service-role-key>

# GitHub secret (used by the weekly backup workflow, never by the app):
#   SUPABASE_ACCESS_TOKEN
#   SUPABASE_PROJECT_REF
#   SUPABASE_DB_PASSWORD
